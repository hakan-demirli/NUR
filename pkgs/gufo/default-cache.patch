new file mode 100644
--- /dev/null
+++ b/src/cli/serve/cache_directory.hpp
@@ -0,0 +1,36 @@
+#ifndef GUFO_CLI_SERVE_CACHE_DIRECTORY_HPP_
+#define GUFO_CLI_SERVE_CACHE_DIRECTORY_HPP_
+
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <optional>
+#include <stdexcept>
+#include <string>
+
+namespace gufo::cli {
+
+inline std::filesystem::path ResolveDiskCacheDirectory(
+    const std::optional<std::filesystem::path>& configured,
+    std::uint16_t port) {
+  if (configured.has_value()) {
+    return *configured;
+  }
+
+  std::filesystem::path root;
+  if (const char* value = std::getenv("XDG_CACHE_HOME");
+      value != nullptr && std::filesystem::path(value).is_absolute()) {
+    root = value;
+  } else if (const char* value = std::getenv("HOME");
+             value != nullptr && std::filesystem::path(value).is_absolute()) {
+    root = std::filesystem::path(value) / ".cache";
+  } else {
+    throw std::runtime_error(
+        "Cannot determine a cache directory; set --cache-disk explicitly");
+  }
+  return root / "gufo" / ("server-" + std::to_string(port));
+}
+
+}  // namespace gufo::cli
+
+#endif  // GUFO_CLI_SERVE_CACHE_DIRECTORY_HPP_
