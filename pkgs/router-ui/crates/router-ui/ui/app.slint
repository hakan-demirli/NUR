import { Theme } from "theme.slint";
import { BlankScreen, ScreensaverScreen, LockScreen, PinPadScreen, AdminMenuScreen, GuestMenuScreen, FanScreen, WifiScreen, StatusScreen, ClientsScreen, SystemScreen, ClientRow } from "screens.slint";

export { ClientRow }

export enum ScreenKind {
    blank,
    screensaver,
    lockscreen,
    pinpad,
    admin_menu,
    guest_menu,
    fan,
    wifi_admin,
    wifi_guest,
    status,
    clients,
    system,
}

export component AppWindow inherits Window {
    title: "router-ui";

    preferred-width: 240px;
    preferred-height: 320px;
    min-width: 240px;
    max-width: 240px;
    min-height: 320px;
    max-height: 320px;
    background: Theme.bg;
    no-frame: false;

    default-font-family: "DejaVu Sans";

    in property <ScreenKind> screen: ScreenKind.lockscreen;

    in property <string> pin_who;
    in property <int>    pin_digits_entered;
    in property <string> pin_message;
    in property <bool>   pin_locked;

    in property <string> fan_mode;

    in property <string> cpu_text;
    in property <string> phy_text;
    in property <string> fan_rpm_text;
    in property <string> fan_pwm_text;

    in property <bool>   wifi_available;
    in property <string> wifi_ssid;
    in property <string> wifi_password;
    in property <image>  wifi_qr;

    in property <string> clock_time;
    in property <string> clock_date;

    in property <string> uplink_label;
    in property <color>  uplink_color;
    in property <string> uplink_detail;
    in property <string> clients_label;
    in property <string> eth_mode;
    in property <string> wan_label;

    in property <[ClientRow]> client_rows;

    in property <string> sys_load;
    in property <string> sys_mem;
    in property <string> sys_flash;
    in property <string> sys_uptime;
    in property <string> sys_brightness;
    in property <bool>   reboot_armed;

    callback wake();
    callback swipe_up();
    callback pick_user(string);
    callback pin_digit(int);
    callback pin_backspace();
    callback pin_cancel();
    callback nav_back();
    callback nav_lock();
    callback open_fan();
    callback open_wifi();
    callback open_status();
    callback open_clients();
    callback open_system();
    callback set_fan_mode(string);
    callback set_eth_mode(string);
    callback brightness_step(int);
    callback do_reboot();

    callback any_touch();

    if root.screen == ScreenKind.blank: BlankScreen {
        wake => { root.wake(); root.any_touch(); }
    }

    if root.screen == ScreenKind.screensaver: ScreensaverScreen {
        time_str: root.clock_time;
        date_str: root.clock_date;
        swipe_up => { root.swipe_up(); root.any_touch(); }
        touched  => { root.any_touch(); }
    }

    if root.screen == ScreenKind.lockscreen: LockScreen {
        admin_chosen => { root.pick_user("admin"); root.any_touch(); }
        guest_chosen => { root.pick_user("guest"); root.any_touch(); }
    }

    if root.screen == ScreenKind.pinpad: PinPadScreen {
        who: root.pin_who;
        digits_entered: root.pin_digits_entered;
        message: root.pin_message;
        locked: root.pin_locked;
        digit(d)    => { root.pin_digit(d); root.any_touch(); }
        backspace() => { root.pin_backspace(); root.any_touch(); }
        cancel()    => { root.pin_cancel(); root.any_touch(); }
    }

    if root.screen == ScreenKind.admin_menu: AdminMenuScreen {
        uplink_label: root.uplink_label;
        uplink_color: root.uplink_color;
        open_fan    => { root.open_fan();  root.any_touch(); }
        open_wifi   => { root.open_wifi(); root.any_touch(); }
        open_status => { root.open_status(); root.any_touch(); }
        open_clients => { root.open_clients(); root.any_touch(); }
        open_system  => { root.open_system(); root.any_touch(); }
        clients_label: root.clients_label;
        lock        => { root.nav_lock(); }
    }

    if root.screen == ScreenKind.clients: ClientsScreen {
        rows: root.client_rows;
        back() => { root.nav_back(); root.any_touch(); }
        lock() => { root.nav_lock(); }
    }

    if root.screen == ScreenKind.system: SystemScreen {
        load_label: root.sys_load;
        mem_label: root.sys_mem;
        flash_label: root.sys_flash;
        uptime_label: root.sys_uptime;
        brightness_label: root.sys_brightness;
        reboot_armed: root.reboot_armed;
        brightness_step(d) => { root.brightness_step(d); root.any_touch(); }
        reboot()           => { root.do_reboot(); root.any_touch(); }
        back()             => { root.nav_back(); root.any_touch(); }
        lock()             => { root.nav_lock(); }
    }

    if root.screen == ScreenKind.status: StatusScreen {
        uplink_label: root.uplink_label;
        uplink_color: root.uplink_color;
        detail_label: root.uplink_detail;
        clients_label: root.clients_label;
        eth_mode: root.eth_mode;
        wan_label: root.wan_label;
        set_eth_mode(m) => { root.set_eth_mode(m); root.any_touch(); }
        back()          => { root.nav_back(); root.any_touch(); }
        lock()          => { root.nav_lock(); }
    }

    if root.screen == ScreenKind.guest_menu: GuestMenuScreen {
        open_wifi => { root.open_wifi(); root.any_touch(); }
        lock      => { root.nav_lock(); }
    }

    if root.screen == ScreenKind.fan: FanScreen {
        current_mode: root.fan_mode;
        cpu_text: root.cpu_text;
        phy_text: root.phy_text;
        rpm_text: root.fan_rpm_text;
        pwm_text: root.fan_pwm_text;
        set_mode(m) => { root.set_fan_mode(m); root.any_touch(); }
        back()      => { root.nav_back(); root.any_touch(); }
        lock()      => { root.nav_lock(); }
    }

    if root.screen == ScreenKind.wifi_admin: WifiScreen {
        title: "WiFi";
        available: root.wifi_available;
        ssid: root.wifi_ssid;
        password: root.wifi_password;
        qr_image: root.wifi_qr;
        back() => { root.nav_back(); root.any_touch(); }
        lock() => { root.nav_lock(); }
    }

    if root.screen == ScreenKind.wifi_guest: WifiScreen {
        title: "Guest WiFi";
        available: root.wifi_available;
        ssid: root.wifi_ssid;
        password: root.wifi_password;
        qr_image: root.wifi_qr;
        back() => { root.nav_back(); root.any_touch(); }
        lock() => { root.nav_lock(); }
    }
}
