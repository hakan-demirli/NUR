import { Theme } from "theme.slint";
import { Tile, TopBar, PinKey, PrimaryButton } from "widgets.slint";

export struct ClientRow {
    name: string,
    ip: string,
    mac: string,
    wireless: bool,
}

component TouchTestCorner inherits Rectangle {
    in property <string> label;
    in property <bool> hit;
    callback clicked();

    width: 68px;
    height: 68px;
    background: root.hit ? Theme.ok : (ta.pressed ? Theme.accent_dim : Theme.surface);
    border-width: 2px;
    border-color: root.hit ? Theme.ok : Theme.text;
    border-radius: Theme.button_radius;

    VerticalLayout {
        alignment: center;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font_lg;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.hit ? "hit" : "tap";
            color: Theme.text;
            font-size: Theme.font_xs;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up && ta.has-hover) { root.clicked(); }
        }
    }
}

component TouchTestDecision inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <color> button_color;
    in property <bool> enabled: true;
    in property <bool> confirmed;
    callback clicked();

    background: root.confirmed ? Theme.ok : (ta.pressed ? Theme.surface_alt : root.button_color);
    border-width: 2px;
    border-color: root.confirmed ? Theme.ok : Theme.text;
    border-radius: Theme.tile_radius;
    opacity: root.enabled ? 1 : 0.45;

    VerticalLayout {
        alignment: center;
        spacing: Theme.pad_xs;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font_md;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.hint;
            color: Theme.text;
            font-size: Theme.font_xs;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up && ta.has-hover) { root.clicked(); }
        }
    }
}

export component TouchTestScreen inherits Rectangle {
    in property <string> variant_label;
    callback corner_tapped(string);
    callback result_chosen(string);

    property <bool> top_left_hit;
    property <bool> top_right_hit;
    property <bool> bottom_left_hit;
    property <bool> bottom_right_hit;
    property <int> good_taps;
    property <int> retry_taps;
    property <string> result;

    background: Theme.bg;

    top-left := TouchTestCorner {
        x: 0;
        y: 0;
        label: "TL";
        hit: root.top_left_hit;
        clicked => {
            root.top_left_hit = true;
            root.good_taps = 0;
            root.retry_taps = 0;
            root.corner_tapped("top-left");
        }
    }

    top-right := TouchTestCorner {
        x: parent.width - self.width;
        y: 0;
        label: "TR";
        hit: root.top_right_hit;
        clicked => {
            root.top_right_hit = true;
            root.good_taps = 0;
            root.retry_taps = 0;
            root.corner_tapped("top-right");
        }
    }

    bottom-left := TouchTestCorner {
        x: 0;
        y: parent.height - self.height;
        label: "BL";
        hit: root.bottom_left_hit;
        clicked => {
            root.bottom_left_hit = true;
            root.good_taps = 0;
            root.retry_taps = 0;
            root.corner_tapped("bottom-left");
        }
    }

    bottom-right := TouchTestCorner {
        x: parent.width - self.width;
        y: parent.height - self.height;
        label: "BR";
        hit: root.bottom_right_hit;
        clicked => {
            root.bottom_right_hit = true;
            root.good_taps = 0;
            root.retry_taps = 0;
            root.corner_tapped("bottom-right");
        }
    }

    looks-good := TouchTestDecision {
        x: 76px;
        y: 8px;
        width: parent.width - 152px;
        height: 104px;
        title: root.result == "looks-good" ? "LOOKS GOOD" : "Looks good";
        hint: root.result == "looks-good" ? "confirmed" :
            root.good_taps == 0 ? "(click 3 times)" :
            root.good_taps == 1 ? "(click 2 more times)" : "(click 1 more time)";
        button_color: Theme.accent;
        confirmed: root.result == "looks-good";
        enabled: root.result == "";
        clicked => {
            root.retry_taps = 0;
            if (root.good_taps == 2) {
                root.good_taps = 3;
                root.result = "looks-good";
                root.result_chosen(root.result);
            } else {
                root.good_taps += 1;
            }
        }
    }

    try-again := TouchTestDecision {
        x: 76px;
        y: 128px;
        width: parent.width - 152px;
        height: 104px;
        title: root.result == "try-something-else" ? "TRY SOMETHING ELSE" : "Try something else";
        hint: root.result == "try-something-else" ? "confirmed" :
            root.retry_taps == 0 ? "(click 3 times)" :
            root.retry_taps == 1 ? "(click 2 more times)" : "(click 1 more time)";
        button_color: Theme.err;
        confirmed: root.result == "try-something-else";
        enabled: root.result == "";
        clicked => {
            root.good_taps = 0;
            if (root.retry_taps == 2) {
                root.retry_taps = 0;
                root.top_left_hit = false;
                root.top_right_hit = false;
                root.bottom_left_hit = false;
                root.bottom_right_hit = false;
                root.result_chosen("try-something-else");
            } else {
                root.retry_taps += 1;
            }
        }
    }

    Text {
        x: 68px;
        y: 113px;
        width: parent.width - 136px;
        height: 14px;
        text: root.variant_label;
        color: Theme.text_dim;
        font-size: Theme.font_xs;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component BlankScreen inherits Rectangle {
    callback wake();
    background: #000;
    TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) { root.wake(); }
        }
    }
}

export component ScreensaverScreen inherits Rectangle {
    in property <string> time_str;
    in property <string> date_str;
    callback swipe_up();
    callback touched();

    background: Theme.bg;

    property <length> swipe_threshold: 60px;

    VerticalLayout {
        alignment: center;
        spacing: Theme.pad_md;

        Text {
            text: root.time_str;
            font-size: Theme.font_clock;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.date_str;
            font-size: Theme.font_md;
            color: Theme.text_dim;
            horizontal-alignment: center;
        }
        Rectangle { height: Theme.pad_lg; }
        Text {
            text: "swipe up to unlock";
            font-size: Theme.font_xs;
            color: Theme.text_dim;
            horizontal-alignment: center;
            opacity: 0.6;
        }
    }

    ta := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.touched();
            }
            if (ev.kind == PointerEventKind.up) {
                if (ta.pressed-y - ta.mouse-y >= root.swipe_threshold) {
                    root.swipe_up();
                }
                root.touched();
            }
        }
    }
}

export component LockScreen inherits Rectangle {
    callback admin_chosen();
    callback guest_chosen();

    background: Theme.bg;
    property <bool> landscape: self.width >= self.height;

    if root.landscape: HorizontalLayout {
        padding: Theme.pad_md;
        spacing: Theme.pad_md;
        Tile {
            label: "Admin";
            sublabel: "fan · wifi";
            tile_color: Theme.admin_tile;
            clicked => { root.admin_chosen(); }
        }
        Tile {
            label: "Guest";
            sublabel: "wifi";
            tile_color: Theme.guest_tile;
            clicked => { root.guest_chosen(); }
        }
    }

    if !root.landscape: VerticalLayout {
        padding: Theme.pad_md;
        spacing: Theme.pad_md;
        Tile {
            label: "Admin";
            sublabel: "fan · wifi";
            tile_color: Theme.admin_tile;
            clicked => { root.admin_chosen(); }
        }
        Tile {
            label: "Guest";
            sublabel: "wifi";
            tile_color: Theme.guest_tile;
            clicked => { root.guest_chosen(); }
        }
    }
}

export component PinPadScreen inherits Rectangle {
    in property <string> who;
    in property <int>    digits_entered;
    in property <int>    digits_required: 4;
    in property <string> message;
    in property <bool>   locked: false;

    callback digit(int);
    callback backspace();
    callback cancel();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad_sm;
        spacing: Theme.pad_sm;

        TopBar {
            title: "Unlock — " + root.who;
            show_lock: false;
            back => { root.cancel(); }
        }

        HorizontalLayout {
            alignment: center;
            spacing: Theme.pad_sm;
            for d[i] in root.digits_required: Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: i < root.digits_entered ? Theme.accent : Theme.surface_alt;
                border-width: 1px;
                border-color: Theme.border;
            }
        }

        Text {
            text: root.message;
            color: Theme.err;
            font-size: Theme.font_sm;
            horizontal-alignment: center;
        }

        GridLayout {
            spacing: Theme.pad_xs;
            Row { PinKey { label: "1"; enabled: !root.locked; clicked => { root.digit(1); } }
                  PinKey { label: "2"; enabled: !root.locked; clicked => { root.digit(2); } }
                  PinKey { label: "3"; enabled: !root.locked; clicked => { root.digit(3); } } }
            Row { PinKey { label: "4"; enabled: !root.locked; clicked => { root.digit(4); } }
                  PinKey { label: "5"; enabled: !root.locked; clicked => { root.digit(5); } }
                  PinKey { label: "6"; enabled: !root.locked; clicked => { root.digit(6); } } }
            Row { PinKey { label: "7"; enabled: !root.locked; clicked => { root.digit(7); } }
                  PinKey { label: "8"; enabled: !root.locked; clicked => { root.digit(8); } }
                  PinKey { label: "9"; enabled: !root.locked; clicked => { root.digit(9); } } }
            Row { PinKey { label: "✕"; enabled: !root.locked; clicked => { root.cancel(); } }
                  PinKey { label: "0"; enabled: !root.locked; clicked => { root.digit(0); } }
                  PinKey { label: "⌫"; enabled: !root.locked; clicked => { root.backspace(); } } }
        }
    }
}

export component AdminMenuScreen inherits Rectangle {
    in property <string> uplink_label;
    in property <color> uplink_color;
    in property <string> clients_label;
    callback open_fan();
    callback open_wifi();
    callback open_status();
    callback open_clients();
    callback open_system();
    callback lock();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad_sm;
        spacing: Theme.pad_sm;

        TopBar { title: "Admin"; show_back: false; lock => { root.lock(); } }

        HorizontalLayout {
            padding-left: Theme.pad_md;
            padding-right: Theme.pad_md;
            Tile { label: "Uplink"; sublabel: root.uplink_label;
                   tile_color: root.uplink_color;
                   clicked => { root.open_status(); } }
        }

        HorizontalLayout {
            spacing: Theme.pad_md;
            padding-left: Theme.pad_md;
            padding-right: Theme.pad_md;
            Tile { label: "Fan";  sublabel: "presets"; tile_color: Theme.surface;
                   clicked => { root.open_fan(); } }
            Tile { label: "WiFi"; sublabel: "QR + key"; tile_color: Theme.surface;
                   clicked => { root.open_wifi(); } }
        }

        HorizontalLayout {
            spacing: Theme.pad_md;
            padding-left: Theme.pad_md;
            padding-right: Theme.pad_md;
            Tile { label: "Clients"; sublabel: root.clients_label; tile_color: Theme.surface;
                   clicked => { root.open_clients(); } }
            Tile { label: "System"; sublabel: "info"; tile_color: Theme.surface;
                   clicked => { root.open_system(); } }
        }
    }
}

export component ClientsScreen inherits Rectangle {
    in property <[ClientRow]> rows;
    callback back();
    callback lock();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad_sm;
        spacing: Theme.pad_xs;

        TopBar { title: "Clients"; back => { root.back(); } lock => { root.lock(); } }

        if root.rows.length == 0: Text {
            text: "no clients";
            color: Theme.text_dim;
            font-size: Theme.font_sm;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }

        if root.rows.length > 0: Flickable {
            vertical-stretch: 1;
            viewport-height: root.rows.length * 46px;

            VerticalLayout {
                spacing: 2px;
                for row in root.rows: Rectangle {
                    height: 44px;
                    background: Theme.surface;
                    border-radius: Theme.button_radius;

                    HorizontalLayout {
                        padding-left: Theme.pad_sm;
                        padding-right: Theme.pad_sm;
                        spacing: Theme.pad_xs;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: row.name;
                                color: Theme.text;
                                font-size: Theme.font_sm;
                                overflow: elide;
                            }
                            Text {
                                text: row.mac;
                                color: Theme.text_dim;
                                font-size: Theme.font_xs;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: row.ip;
                                color: Theme.text;
                                font-size: Theme.font_xs;
                                horizontal-alignment: right;
                            }
                            Text {
                                text: row.wireless ? "wifi" : "wired";
                                color: row.wireless ? Theme.accent_alt : Theme.text_dim;
                                font-size: Theme.font_xs;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SystemScreen inherits Rectangle {
    in property <string> load_label;
    in property <string> mem_label;
    in property <string> flash_label;
    in property <string> uptime_label;
    in property <string> brightness_label;
    in property <bool> reboot_armed;

    callback brightness_step(int);
    callback reboot();
    callback back();
    callback lock();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad_sm;
        spacing: Theme.pad_xs;

        TopBar { title: "System"; back => { root.back(); } lock => { root.lock(); } }

        for entry in [
            { k: "load", v: root.load_label },
            { k: "memory", v: root.mem_label },
            { k: "flash", v: root.flash_label },
            { k: "uptime", v: root.uptime_label },
        ]: Rectangle {
            height: 28px;
            background: Theme.surface;
            border-radius: Theme.button_radius;
            HorizontalLayout {
                padding-left: Theme.pad_sm;
                padding-right: Theme.pad_sm;
                Text { text: entry.k; color: Theme.text_dim; font-size: Theme.font_xs;
                       vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: entry.v; color: Theme.text; font-size: Theme.font_xs;
                       vertical-alignment: center; }
            }
        }

        HorizontalLayout {
            spacing: Theme.pad_sm;
            Rectangle {
                width: 44px;
                height: 36px;
                background: ta-dim.pressed ? Theme.surface_alt : Theme.surface;
                border-radius: Theme.button_radius;
                Text { text: "-"; color: Theme.text; font-size: Theme.font_md;
                       horizontal-alignment: center; vertical-alignment: center; }
                ta-dim := TouchArea {
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.up && ta-dim.has-hover) {
                            root.brightness_step(-1);
                        }
                    }
                }
            }
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.button_radius;
                horizontal-stretch: 1;
                Text { text: root.brightness_label; color: Theme.text;
                       font-size: Theme.font_xs; horizontal-alignment: center;
                       vertical-alignment: center; }
            }
            Rectangle {
                width: 44px;
                height: 36px;
                background: ta-bright.pressed ? Theme.surface_alt : Theme.surface;
                border-radius: Theme.button_radius;
                Text { text: "+"; color: Theme.text; font-size: Theme.font_md;
                       horizontal-alignment: center; vertical-alignment: center; }
                ta-bright := TouchArea {
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.up && ta-bright.has-hover) {
                            root.brightness_step(1);
                        }
                    }
                }
            }
        }

        Rectangle {
            height: Theme.touch_min;
            background: root.reboot_armed ? Theme.err : Theme.surface;
            border-radius: Theme.button_radius;
            Text {
                text: root.reboot_armed ? "tap again to reboot" : "Reboot";
                color: Theme.text;
                font-size: Theme.font_sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta-reboot := TouchArea {
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.up && ta-reboot.has-hover) {
                        root.reboot();
                    }
                }
            }
        }
    }
}

export component StatusScreen inherits Rectangle {
    in property <string> uplink_label;
    in property <color> uplink_color;
    in property <string> detail_label;
    in property <string> clients_label;
    in property <string> eth_mode;
    in property <string> wan_label;

    callback set_eth_mode(string);
    callback back();
    callback lock();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad_sm;
        spacing: Theme.pad_sm;

        TopBar { title: "Uplink"; back => { root.back(); } lock => { root.lock(); } }

        Rectangle {
            height: 62px;
            background: root.uplink_color;
            border-radius: Theme.tile_radius;
            VerticalLayout {
                padding: Theme.pad_xs;
                Text { text: root.uplink_label; color: Theme.text;
                       font-size: Theme.font_md; horizontal-alignment: center; }
                Text { text: root.detail_label; color: Theme.text;
                       font-size: Theme.font_xs; horizontal-alignment: center;
                       wrap: word-wrap; }
            }
        }

        Rectangle {
            height: 26px;
            background: Theme.surface;
            border-radius: Theme.button_radius;
            Text { text: root.clients_label; color: Theme.text_dim;
                   font-size: Theme.font_xs; horizontal-alignment: center;
                   vertical-alignment: center; }
        }

        Text { text: "Ethernet ports"; color: Theme.text_dim;
               font-size: Theme.font_xs; horizontal-alignment: center; }

        HorizontalLayout {
            spacing: Theme.pad_sm;
            Rectangle {
                height: Theme.touch_min;
                background: root.eth_mode == "dual-lan" ? Theme.accent : Theme.surface;
                border-radius: Theme.button_radius;
                Text { text: "2x LAN"; color: Theme.text; font-size: Theme.font_sm;
                       horizontal-alignment: center; vertical-alignment: center; }
                ta-dual := TouchArea {
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.up && ta-dual.has-hover) {
                            root.set_eth_mode("dual-lan");
                        }
                    }
                }
            }
            Rectangle {
                height: Theme.touch_min;
                background: root.eth_mode == "wired-wan" ? Theme.accent : Theme.surface;
                border-radius: Theme.button_radius;
                Text { text: "WAN+LAN"; color: Theme.text; font-size: Theme.font_sm;
                       horizontal-alignment: center; vertical-alignment: center; }
                ta-wan := TouchArea {
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.up && ta-wan.has-hover) {
                            root.set_eth_mode("wired-wan");
                        }
                    }
                }
            }
        }

        Text { text: root.wan_label; color: Theme.text_dim;
               font-size: Theme.font_xs; horizontal-alignment: center; }
    }
}

export component GuestMenuScreen inherits Rectangle {
    callback open_wifi();
    callback lock();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad_sm;
        spacing: Theme.pad_sm;

        TopBar { title: "Guest"; show_back: false; lock => { root.lock(); } }

        HorizontalLayout {
            padding-left: 80px;
            padding-right: 80px;
            Tile { label: "WiFi"; sublabel: "QR + key"; tile_color: Theme.guest_tile;
                   clicked => { root.open_wifi(); } }
        }
    }
}

export component FanScreen inherits Rectangle {

    in property <string> current_mode;

    in property <string> cpu_text;
    in property <string> phy_text;
    in property <string> rpm_text;
    in property <string> pwm_text;

    callback set_mode(string);
    callback back();
    callback lock();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad_sm;
        spacing: Theme.pad_sm;

        TopBar { title: "Fan"; back => { root.back(); } lock => { root.lock(); } }

        HorizontalLayout {
            spacing: Theme.pad_sm;
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.button_radius;
                VerticalLayout {
                    padding: Theme.pad_xs;
                    Text { text: "CPU"; color: Theme.text_dim; font-size: Theme.font_xs;
                           horizontal-alignment: center; }
                    Text { text: root.cpu_text; color: Theme.text;
                           font-size: Theme.font_md; horizontal-alignment: center; }
                }
            }
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.button_radius;
                VerticalLayout {
                    padding: Theme.pad_xs;
                    Text { text: "PHY"; color: Theme.text_dim; font-size: Theme.font_xs;
                           horizontal-alignment: center; }
                    Text { text: root.phy_text; color: Theme.text;
                           font-size: Theme.font_md; horizontal-alignment: center; }
                }
            }
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.button_radius;
                VerticalLayout {
                    padding: Theme.pad_xs;
                    Text { text: "RPM"; color: Theme.text_dim; font-size: Theme.font_xs;
                           horizontal-alignment: center; }
                    Text { text: root.rpm_text; color: Theme.text;
                           font-size: Theme.font_md; horizontal-alignment: center; }
                }
            }
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.button_radius;
                VerticalLayout {
                    padding: Theme.pad_xs;
                    Text { text: "PWM"; color: Theme.text_dim; font-size: Theme.font_xs;
                           horizontal-alignment: center; }
                    Text { text: root.pwm_text; color: Theme.text;
                           font-size: Theme.font_md; horizontal-alignment: center; }
                }
            }
        }

        GridLayout {
            spacing: Theme.pad_sm;
            Row {
                Rectangle {
                    background: root.current_mode == "auto" ? Theme.accent : Theme.surface;
                    border-radius: Theme.button_radius;
                    height: Theme.touch_min;
                    Text { text: "Auto"; color: Theme.text; font-size: Theme.font_md;
                           horizontal-alignment: center; vertical-alignment: center; }
                    ta-auto := TouchArea {
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.up && ta-auto.has-hover) {
                                root.set_mode("auto");
                            }
                        }
                    }
                }
                Rectangle {
                    background: root.current_mode == "quiet" ? Theme.accent : Theme.surface;
                    border-radius: Theme.button_radius;
                    height: Theme.touch_min;
                    Text { text: "Quiet"; color: Theme.text; font-size: Theme.font_md;
                           horizontal-alignment: center; vertical-alignment: center; }
                    ta-quiet := TouchArea {
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.up && ta-quiet.has-hover) {
                                root.set_mode("quiet");
                            }
                        }
                    }
                }
            }
            Row {
                Rectangle {
                    background: root.current_mode == "aggressive" ? Theme.accent : Theme.surface;
                    border-radius: Theme.button_radius;
                    height: Theme.touch_min;
                    Text { text: "Aggressive"; color: Theme.text; font-size: Theme.font_md;
                           horizontal-alignment: center; vertical-alignment: center; }
                    ta-aggr := TouchArea {
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.up && ta-aggr.has-hover) {
                                root.set_mode("aggressive");
                            }
                        }
                    }
                }
                Rectangle {
                    background: root.current_mode == "manual" ? Theme.accent : Theme.surface;
                    border-radius: Theme.button_radius;
                    height: Theme.touch_min;
                    Text { text: "Manual"; color: Theme.text; font-size: Theme.font_md;
                           horizontal-alignment: center; vertical-alignment: center; }
                    ta-manu := TouchArea {
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.up && ta-manu.has-hover) {
                                root.set_mode("manual");
                            }
                        }
                    }
                }
            }
        }
    }
}

export component WifiScreen inherits Rectangle {
    in property <string> title;
    in property <bool>   available;
    in property <string> ssid;
    in property <string> password;
    in property <image>  qr_image;
    callback back();
    callback lock();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad_sm;
        spacing: Theme.pad_sm;

        TopBar { title: root.title; back => { root.back(); } lock => { root.lock(); } }

        if !root.available: Text {
            text: "Not configured.\nUse the admin UI to enable.";
            color: Theme.text_dim;
            font-size: Theme.font_sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.available: HorizontalLayout {
            spacing: Theme.pad_md;

            Rectangle {
                width: 140px;
                background: Theme.surface;
                border-radius: Theme.button_radius;
                Image { source: root.qr_image; width: 130px; height: 130px;
                        image-fit: contain; }
            }

            VerticalLayout {
                spacing: Theme.pad_xs;
                Text { text: "SSID"; color: Theme.text_dim; font-size: Theme.font_xs; }
                Text { text: root.ssid; color: Theme.text; font-size: Theme.font_md;
                       wrap: word-wrap; }
                Text { text: "Password"; color: Theme.text_dim; font-size: Theme.font_xs; }
                Text { text: root.password; color: Theme.text; font-size: Theme.font_md;
                       wrap: word-wrap; }
            }
        }
    }
}
