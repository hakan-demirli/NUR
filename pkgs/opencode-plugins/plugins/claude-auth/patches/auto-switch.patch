 const SYNC_INTERVAL = 5 * 60 * 1000 // 5 minutes
 
+// ---------- Auto-switch (multi-account cooldown rotation) ----------
+//
+// Configuration lives at:
+//   ${XDG_CONFIG_HOME:-$HOME/.config}/opencode-plugins/claude-auth/config.json
+//
+// Schema:
+//   {
+//     "autoSwitch": {
+//       "order": ["home:~/.cache/claude-multi/work", "file"]
+//     }
+//   }
+//
+// Sources are matched against the values returned by readAllClaudeAccounts():
+// `file` for the default ~/.claude/.credentials.json, or `home:<absolute>` for
+// an extra home discovered under ~/.cache/claude-multi/ or listed in
+// OPENCODE_CLAUDE_AUTH_EXTRA_HOMES. `~` and `~/` are expanded in source paths.
+// When the config file is absent or empty, ordering falls back to the natural
+// discovery order (file first), preserving upstream behavior.
+
+interface AccountCooldown {
+  resetAt: number
+  reason: string
+}
+
+interface AutoSwitchConfig {
+  order?: unknown
+}
+
+interface PluginConfig {
+  autoSwitch?: AutoSwitchConfig
+}
+
+const accountCooldowns = new Map<string, AccountCooldown>()
+let cachedPluginConfig: PluginConfig | null = null
+let pluginConfigLoaded = false
+
+function getPluginConfigPath(): string {
+  const xdg = process.env.XDG_CONFIG_HOME
+  const base = xdg && xdg.length > 0 ? xdg : join(homedir(), ".config")
+  return join(base, "opencode-plugins", "claude-auth", "config.json")
+}
+
+function expandHome(p: string): string {
+  if (p === "~") return homedir()
+  if (p.startsWith("~/")) return join(homedir(), p.slice(2))
+  return p
+}
+
+function normalizeSource(s: string): string {
+  const trimmed = s.trim()
+  if (!trimmed) return ""
+  if (trimmed.startsWith("home:")) return "home:" + expandHome(trimmed.slice(5))
+  return trimmed
+}
+
+function loadPluginConfig(): PluginConfig {
+  if (pluginConfigLoaded && cachedPluginConfig) return cachedPluginConfig
+  const path = getPluginConfigPath()
+  let parsed: PluginConfig = {}
+  try {
+    const raw = readFileSync(path, "utf-8")
+    parsed = JSON.parse(raw) as PluginConfig
+    log("plugin_config_loaded", { path })
+  } catch (err) {
+    const code = (err as NodeJS.ErrnoException | undefined)?.code
+    if (code === "ENOENT") {
+      log("plugin_config_absent", { path })
+    } else {
+      log("plugin_config_unavailable", {
+        path,
+        reason: err instanceof Error ? err.message : String(err),
+      })
+    }
+  }
+  cachedPluginConfig = parsed ?? {}
+  pluginConfigLoaded = true
+  return cachedPluginConfig
+}
+
+function formatDuration(ms: number): string {
+  const totalSec = Math.max(0, Math.round(ms / 1000))
+  const h = Math.floor(totalSec / 3600)
+  const m = Math.floor((totalSec % 3600) / 60)
+  const s = totalSec % 60
+  if (h > 0) return `${h}h${m.toString().padStart(2, "0")}m`
+  if (m > 0) return `${m}m${s.toString().padStart(2, "0")}s`
+  return `${s}s`
+}
+
+const DEFAULT_RATE_LIMIT_COOLDOWN_SEC = 120
+const DEFAULT_QUOTA_COOLDOWN_SEC = 300
+const QUOTA_ERROR_PATTERNS = [
+  "insufficient_quota",
+  "billing_not_active",
+  "usage_limit",
+  "credit balance is too low",
+  "exceeded your current quota",
+  "account has been disabled",
+  "monthly spending limit",
+]
+
+function sourceLabel(source: string): string {
+  if (source === "file") return "default"
+  if (source.startsWith("home:")) {
+    const home = source.slice(5)
+    const parts = home.replace(/\/+$/, "").split("/")
+    return parts[parts.length - 1] || home
+  }
+  return source
+}
+
+function isQuotaExhaustion(body: string): boolean {
+  const lower = body.toLowerCase()
+  return QUOTA_ERROR_PATTERNS.some((p) => lower.includes(p))
+}
+
+function getEarliestCooldownReset(): {
+  source: string
+  resetAt: number
+} | null {
+  let earliest: { source: string; resetAt: number } | null = null
+  for (const [source, cd] of accountCooldowns) {
+    if (!earliest || cd.resetAt < earliest.resetAt) {
+      earliest = { source, resetAt: cd.resetAt }
+    }
+  }
+  return earliest
+}
+
+function buildAccountStatusSummary(): string {
+  const now = Date.now()
+  const order = getAutoSwitchOrder()
+  const parts: string[] = []
+  for (const src of order) {
+    const label = sourceLabel(src)
+    const cd = accountCooldowns.get(src)
+    if (!cd || cd.resetAt <= now) {
+      parts.push(`${label}: ok`)
+    } else {
+      parts.push(`${label}: ${formatDuration(cd.resetAt - now)}`)
+    }
+  }
+  return parts.join(" | ")
+}
+
+function getAutoSwitchOrder(): string[] {
+  const cfg = loadPluginConfig()
+  const raw = cfg.autoSwitch?.order
+  if (Array.isArray(raw)) {
+    const out: string[] = []
+    for (const entry of raw) {
+      if (typeof entry !== "string") continue
+      const norm = normalizeSource(entry)
+      if (norm) out.push(norm)
+    }
+    if (out.length > 0) return out
+  }
+  return getAccounts().map((a) => a.source)
+}
+
+function pickActiveSource(): string | null {
+  const order = getAutoSwitchOrder()
+  const now = Date.now()
+  for (const src of order) {
+    const cd = accountCooldowns.get(src)
+    if (!cd || cd.resetAt <= now) {
+      if (cd) {
+        accountCooldowns.delete(src)
+        log("account_cooldown_expired", { source: src })
+      }
+      return src
+    }
+  }
+  // All accounts on cooldown -- pick the one that unlocks soonest
+  let earliest: { source: string; resetAt: number } | null = null
+  for (const src of order) {
+    const cd = accountCooldowns.get(src)
+    if (cd && (!earliest || cd.resetAt < earliest.resetAt)) {
+      earliest = { source: src, resetAt: cd.resetAt }
+    }
+  }
+  return earliest?.source ?? order[0] ?? null
+}
+
+function markAccountCooldown(
+  source: string,
+  retryAfterSec: number,
+  reason: string,
+): void {
+  const resetAt = Date.now() + retryAfterSec * 1000
+  accountCooldowns.set(source, { resetAt, reason })
+  log("account_cooldown_set", {
+    source,
+    retryAfterSec,
+    resetAt,
+    reason,
+  })
+  const summary = buildAccountStatusSummary()
+}
+
